# CampusRide / SaiTrack Environment Configuration

PORT=3000
NODE_ENV=development

# JWT Security Key (Replace with a strong random string in production: openssl rand -hex 32)
JWT_SECRET=campusride_dev_secret_key_2026_xyz
JWT_EXPIRES_IN=24h

# Operational Mode
# Set DEMO_MODE=false in production to disable sample indicators
DEMO_MODE=true
# Set SIMULATION_ENABLED=true to run the virtual driver bus movement loop
SIMULATION_ENABLED=false
# Set EXPOSE_MOCK_OTP=true only during local automated testing; leave false in production
EXPOSE_MOCK_OTP=false

# Verified Campus Geographic Coordinates (Sri Sairam Engineering College)
CAMPUS_NAME=Sri Sairam Engineering College
CAMPUS_CODE=SEC
CAMPUS_ADDRESS=Sai Leo Nagar, West Tambaram, Chennai - 600044
CAMPUS_LAT=12.9601
CAMPUS_LNG=80.0574
CAMPUS_GEOFENCE_RADIUS=300

# OpenStreetMap Tile Server (uses standard OSM tiles by default)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Hardware Ingest Keys (for GPS trackers and UHF RFID bus scanners)
GPS_DEVICE_API_KEY=gps_device_dev_key_sec_2026
RFID_READER_API_KEY=rfid_reader_dev_key_sec_2026
RFID_DEBOUNCE_MS=300000
